# GoHighLevel sub-account (location) for Anthony Insurance Services.
# Create a Private Integration token in GHL: Settings → Private Integrations → Create.
# Scopes needed (names as shown in GHL — confirm when creating the token):
#   View/Edit Contacts, View Custom Fields, and Forms write (used to upload the signature image)
GHL_API_TOKEN=
# Settings → Business Profile → "Location ID" (also in the sub-account URL)
GHL_LOCATION_ID=

# Protects /api/admin/ghl-mapping (the field-mapping audit). Use a long random string.
ADMIN_SECRET=

# Optional: point the GHL client at a mock server for local testing.
# GHL_API_BASE_URL=http://localhost:4010
