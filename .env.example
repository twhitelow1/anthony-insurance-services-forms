# TESTING ONLY: set to 1 (or true) to switch sign-in off. Everyone can open /admin and every PDF.
# Delete it (and redeploy) to turn sign-in back on.
# OPEN_ACCESS=1

# ── App ─────────────────────────────────────────────────────────────
# Public URL (used in emails, Lead Alchemist links and sign-in links)
APP_URL=https://anthony-insurance-services-forms.vercel.app
# 32+ random characters; signs session cookies. Any password generator works.
SESSION_SECRET=
# Time zone for dates shown in the portal
APP_TIMEZONE=America/Chicago

# ── Database ────────────────────────────────────────────────────────
# Production: Neon Postgres from Vercel Storage (sets DATABASE_URL for you).
# Local dev without Postgres: pglite:./.data/db  (embedded, auto-migrates)
DATABASE_URL=

# ── Settings you can also change in Admin → Settings ────────────────
# Admins, notification emails, sender / reply-to, carrier email and the Lead Alchemist
# pipeline can all be set in the app (Admin → Settings). Values saved there
# win; the variables below are only the fallback. STAFF_EMAILS always counts
# as admin, so keep at least your own address here.

# ── Staff sign-in (emailed one-time links) ──────────────────────────
# Any address at these domains can request a staff sign-in link...
STAFF_EMAIL_DOMAINS=anthonyinsuranceservices.com
# ...unless this list is set, in which case ONLY these addresses can.
# STAFF_EMAILS=melanie@anthonyinsuranceservices.com,amy@anthonyinsuranceservices.com

# ── Email (Resend) ──────────────────────────────────────────────────
# resend.com → API Keys. The From domain must be verified in Resend (Domains).
RESEND_API_KEY=
MAIL_FROM="Anthony Insurance Services <applications@anthonyinsuranceservices.com>"
# Where client replies go (optional)
MAIL_REPLY_TO=

# Staff who get an email for every new application (comma-separated). Optional.
NOTIFY_EMAILS=

# ── Carrier submission (downloadable Outlook draft) ─────────────────
# Pre-filled To: on the draft (comma-separated, optional)
CARRIER_EMAIL=
# Subject tag your Exchange rule encrypts on
MAIL_ENCRYPT_TAG=[encrypt]

# ── Lead Alchemist ─────────────────────────────────────────────────────
# Sub-account Private Integration token: Settings → Private Integrations.
# Scopes: View/Edit Contacts, View/Edit Custom Fields, View/Edit Opportunities.
# (Edit Custom Fields lets the app create its link fields: Client Page Link, Salesforce links.)
# Older variable names are still read as a fallback, but use LA_.
LA_API_TOKEN=
LA_LOCATION_ID=
# Opportunities (optional): pipeline + the stage new applications land in.
# One opportunity per application. IDs or names as shown in Lead Alchemist both work.
LA_PIPELINE_ID=
LA_PIPELINE_STAGE_ID=
# Optional: where leads wait before applying. Their open opportunity there is
# moved into the applications pipeline when they apply. Stage narrows it.
# LA_LEAD_PIPELINE_ID=Leads
# LA_LEAD_STAGE_ID=Lead Calendar
# Optional: Lead Alchemist address for "Open in Lead Alchemist" links (this is the default).
# LA_APP_URL=https://app.leadalchemist.io
# Optional: move the opportunity when the status changes (JSON, status → stage ID).
# Statuses: received in_review info_needed submitted_to_carrier quoted bound declined withdrawn
# LA_STAGE_IDS={"in_review":"<stage id>","quoted":"<stage id>","bound":"<stage id>"}

# ── Salesforce — optional (docs/salesforce-setup.md) ───────────────────
# Turn the sync on, and dry run vs live, in Admin → Settings → Salesforce.
# My Domain login URL (sandbox: https://<domain>--<sandbox>.sandbox.my.salesforce.com).
# SALESFORCE_LOGIN_URL=https://<domain>.my.salesforce.com
# External Client App (or Connected App) with the client credentials flow:
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# Where staff open records (links in the app and Lead Alchemist):
# SALESFORCE_LIGHTNING_URL=https://dg0000000i7rimaa.lightning.force.com
# SALESFORCE_API_VERSION=v62.0
# Fallbacks when nothing is saved in Admin → Settings:
# SALESFORCE_SYNC_ENABLED=0            (1 = on)
# SALESFORCE_DRY_RUN=                  (1 = log only, 0 = write; default: dry run except Vercel production)
# SALESFORCE_STAGE_MAP={"received":"Prospecting","bound":"Closed Won"}
# Vercel Cron (daily retries) and the backfill CLI authenticate with this (32+ random characters):
# CRON_SECRET=

# ── Claude (AI pre-review + "Ask AI") — optional ────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Microsoft 365 — optional ────────────────────────────────────────
# AZURE_CLIENT_ID + AZURE_CLIENT_SECRET turn on staff single sign-on: staff already signed
# in to Microsoft 365 in the browser go straight into the admin; others get the email link.
# Multi-tenant: any organisation's Microsoft 365 works if the email is on the Admins list.
# Register the app as "Accounts in any organizational directory", redirect URI
# <APP_URL>/api/auth/microsoft/callback. See docs/microsoft-sso-setup.md.
# AZURE_CLIENT_ID=  AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID is only needed for Graph mail (Anthony's tenant ID).
# AZURE_TENANT_ID=
# Also setting MAIL_SENDER sends mail via Graph instead of Resend (keep unset for now).
# MAIL_SENDER=

# ── Local development only ──────────────────────────────────────────
# Without RESEND_API_KEY, emails (and sign-in links) print to the console in dev.
# DEV_STAFF_LOGIN=1 adds a "Dev sign-in" button on /admin/login (never in production).
# LA_API_BASE_URL= RESEND_BASE_URL= ANTHROPIC_BASE_URL=   (point at mock servers)
