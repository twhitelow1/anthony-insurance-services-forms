# ── App ─────────────────────────────────────────────────────────────
# Public URL of this app (used in emails and the GHL "Application Link" field)
APP_URL=https://forms.anthonyinsuranceservices.com
# 32+ random characters; signs session cookies. `openssl rand -base64 48`
SESSION_SECRET=
# Time zone for dates shown in the portal
APP_TIMEZONE=America/Chicago

# ── Database ────────────────────────────────────────────────────────
# Production: Neon Postgres from the Vercel Marketplace (sets DATABASE_URL for you).
# Local dev without Postgres: pglite:./.data/db  (embedded, auto-migrates)
DATABASE_URL=

# ── GoHighLevel (contact only) ──────────────────────────────────────
# Sub-account Private Integration token: Settings → Private Integrations.
# Scopes: View/Edit Contacts, View Custom Fields.
GHL_API_TOKEN=
GHL_LOCATION_ID=

# ── Microsoft 365 (one Entra app registration does both) ────────────
#  • Staff sign-in (delegated: openid, profile, email)
#  • Sending mail as MAIL_SENDER: grant the Exchange RBAC role
#    "Application Mail.Send" scoped to that mailbox. Do NOT add Mail.Send
#    in Entra — that would allow sending as anyone in the tenant.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Comma-separated email domains allowed into /admin
STAFF_EMAIL_DOMAINS=anthonyinsuranceservices.com
# Mailbox the app sends from (sign-in links, confirmations, status updates, carrier PDFs)
MAIL_SENDER=applications@anthonyinsuranceservices.com
# Subject tag that the Exchange transport rule encrypts on — confirm the exact text
MAIL_ENCRYPT_TAG=[encrypt]

# ── Local development only ──────────────────────────────────────────
# Without AZURE_* / MAIL_SENDER, emails are printed to the console in dev.
# DEV_STAFF_LOGIN=1 adds a "Dev sign-in" button on /admin/login (never works in production).
# DEV_STAFF_LOGIN=1
# Point integrations at mock servers for testing:
# GHL_API_BASE_URL= ENTRA_LOGIN_BASE= GRAPH_BASE_URL=
